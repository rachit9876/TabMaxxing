{
  "manifest_version": 3,
  "name": "TabMaxxing - Supercharge Your Browser Tabs",
  "version": "5.0.0",
  "description": "Max out your tabs: Visual privacy, audio leveling, 1-click clipboard copier, text spoofing, area search, and browser tools.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "tabs",
    "activeTab",
    "clipboardWrite",
    "contextMenus",
    "downloads",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js", "js/adblock/adblock-cosmetic.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["insta-dl.js"],
      "css": ["insta-dl.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "TabMaxxing"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "js/adblock/specific-rules.json",
        "js/adblock/generic-rules.json"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "custom-shortcut": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Customizable TabMaxxing Shortcut"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ublock-filters",
        "enabled": false,
        "path": "rules/adblock/ublock-filters.json"
      },
      {
        "id": "easylist",
        "enabled": false,
        "path": "rules/adblock/easylist.json"
      },
      {
        "id": "easyprivacy",
        "enabled": false,
        "path": "rules/adblock/easyprivacy.json"
      },
      {
        "id": "pgl",
        "enabled": false,
        "path": "rules/adblock/pgl.json"
      },
      {
        "id": "ublock-badware",
        "enabled": false,
        "path": "rules/adblock/ublock-badware.json"
      },
      {
        "id": "urlhaus-full",
        "enabled": false,
        "path": "rules/adblock/urlhaus-full.json"
      },
      {
        "id": "block_images",
        "enabled": false,
        "path": "rules/block_images.json"
      },
      {
        "id": "block_videos",
        "enabled": false,
        "path": "rules/block_videos.json"
      }
    ]
  }
}